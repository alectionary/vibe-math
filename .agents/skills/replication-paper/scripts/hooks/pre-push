#!/usr/bin/env python3
"""Before every push, consider the paper of each study the push changes.

Install once per clone:  git config core.hooksPath .agents/skills/replication-paper/scripts/hooks

For each pushed commit range, every study directory (one holding
REPLICATION-PLAN.yaml) that the range changes is checked:

- each commit that changes the study outside paper/ must carry a
  `Paper: updated | pending | not-needed <reason>` trailer (blocks the push);
- the paper's freshness is printed; when it is not current, the reminder says
  that the study's pull request must be a draft with the note, and how to check it.
"""

import subprocess
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE.parent))
import paper_freshness  # noqa: E402

ZERO = "0" * 40


def git(*args):
    return subprocess.run(["git", *args], capture_output=True, text=True, check=True).stdout.strip()


def main():
    top = Path(git("rev-parse", "--show-toplevel"))
    failed = False
    for line in sys.stdin:
        parts = line.split()
        if len(parts) != 4 or parts[1] == ZERO:
            continue  # deletion
        local, remote = parts[1], parts[3]
        base = remote if remote != ZERO else git("merge-base", local, "origin/master")
        changed = git("diff", "--name-only", f"{base}..{local}").split()
        studies = set()
        for name in changed:
            p = (top / name).parent
            while p != top and p != p.parent:
                if (p / "REPLICATION-PLAN.yaml").is_file():
                    studies.add(p)
                    break
                p = p.parent
        for study in sorted(studies):
            rel = study.relative_to(top)
            errors = paper_freshness.commit_errors(study, base)
            state = paper_freshness.freshness(study)
            print(f"[paper] {rel}: paper is {state['state']}", file=sys.stderr)
            for item in state["stale"][:10] + state["draft"]:
                print(f"[paper]   {item}", file=sys.stderr)
            if state["state"] in ("stale", "draft"):
                print(f"[paper]   The study's PR must be a draft opening with '{paper_freshness.DRAFT_NOTE}'. "
                      f"Check: python3 .agents/skills/replication-paper/scripts/paper_freshness.py pr --root {rel} --pr N",
                      file=sys.stderr)
            for e in errors:
                print(f"[paper] BLOCKED {e}", file=sys.stderr)
            failed |= bool(errors)
    if failed:
        print("[paper] Add a Paper: trailer to each commit (git commit --amend or rebase) after deciding "
              "whether the paper needs revising.", file=sys.stderr)
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
