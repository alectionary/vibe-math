def edgeMap (e : E) : E := Fin.ofNat 756 (mapData.get e.val)
abbrev oldDecoder := CyclicDecoderOriginal.decoder
abbrev newDecoder := CyclicDecoderTubeData.PreviousHoldout.decoder
abbrev oldTarget := CyclicDecoderOriginal.target
abbrev newTarget := CyclicDecoderTubeData.PreviousHoldout.target
def vertex : V := 5

theorem outside_sources : ∀ e ∈ oldDecoder.incident vertex,
    (oldDecoder.edgeCheck e).val ≠ 0 ∧ (oldDecoder.edgeCheck e).val ≠ 75 := by
  decide +kernel

/-- On this off-source variable, changing the rule at the same incoming state
has no direct effect, for every incoming message vector. -/
theorem no_direct_forcing (q : E → Int) :
    posterior oldDecoder oldTarget (fun e => q (edgeMap e)) vertex =
    posterior newDecoder newTarget q vertex := by
  rfl

theorem old_value : posterior oldDecoder oldTarget
    (CyclicDecoderReachData.Original.state 9) vertex = -240643 := by
  decide +kernel

theorem merged_value : posterior newDecoder newTarget
    (CyclicDecoderReachData.Merged.state 9) vertex = 3120524 := by
  decide +kernel

theorem old_from_prior : posterior oldDecoder oldTarget
    (CyclicDecoderPersistence.orbit (next oldDecoder oldTarget)
      (fun _ => CyclicMergedMessages.prior) 9) vertex = -240643 := by
  rw [CyclicDecoderReachProofs.Original.exact_prefix 9 (by decide)]
  exact old_value

theorem merged_from_prior : posterior newDecoder newTarget
    (CyclicDecoderPersistence.orbit (next newDecoder newTarget)
      (fun _ => CyclicMergedMessages.prior) 9) vertex = 3120524 := by
  rw [CyclicDecoderReachProofs.Merged.exact_prefix 9 (by decide)]
  exact merged_value

/-- The iteration-ten hard-decision difference is inherited from different
incoming states, not a directly changed source-check rule at this variable. -/
theorem inherited_crossing_from_prior :
    CyclicMergedMessages.decision (posterior oldDecoder oldTarget
      (CyclicDecoderPersistence.orbit (next oldDecoder oldTarget)
        (fun _ => CyclicMergedMessages.prior) 9) vertex) ≠
    CyclicMergedMessages.decision (posterior newDecoder newTarget
      (CyclicDecoderPersistence.orbit (next newDecoder newTarget)
        (fun _ => CyclicMergedMessages.prior) 9) vertex) := by
  rw [old_from_prior, merged_from_prior]
  decide
end Previous
