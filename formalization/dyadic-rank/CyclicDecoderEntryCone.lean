  change (directlyAffected e ∨ ∃ f, CyclicDecoderEntry.updateDepends oldDecoder e f ∧
    CyclicDecoderEntry.cone (CyclicDecoderEntry.updateDepends oldDecoder) directlyAffected k f) ↔ _
  apply or_congr Iff.rfl
  constructor
  · rintro ⟨f,hf,h⟩
    exact ⟨f,hf,(previous f).mp h⟩
  · rintro ⟨f,hf,h⟩
    exact ⟨f,hf,(previous f).mpr h⟩

theorem cone1_iff (e : E) : CyclicDecoderEntry.cone
    (CyclicDecoderEntry.updateDepends oldDecoder) directlyAffected 1 e ↔ flag1 e = true := by
  change (directlyAffected e ∨ ∃ f, CyclicDecoderEntry.updateDepends oldDecoder e f ∧ False) ↔ _
  simp only [and_false, exists_false, or_false]
  rw [← first_certificate, directly_true]

theorem cone2_iff (e : E) : CyclicDecoderEntry.cone
    (CyclicDecoderEntry.updateDepends oldDecoder) directlyAffected 2 e ↔ flag2 e = true := by
  have h := next_cone_iff 1 flag1 cone1_iff e
  rw [second_certificate] at h
  exact h

theorem cone3_iff (e : E) : CyclicDecoderEntry.cone
    (CyclicDecoderEntry.updateDepends oldDecoder) directlyAffected 3 e ↔ flag3 e = true := by
  have h := next_cone_iff 2 flag2 cone2_iff e
  rw [third_certificate] at h
  exact h

/-- Every coordinate is in the possible-influence cone after four updates.
This does not assert that every coordinate actually differs. -/
theorem full_cone_at_four (e : E) : CyclicDecoderEntry.cone
    (CyclicDecoderEntry.updateDepends oldDecoder) directlyAffected 4 e := by
  have h := next_cone_iff 3 flag3 cone3_iff e
  rw [fourth_certificate] at h
  exact h.mpr rfl

theorem cone1_count : (List.ofFn flag1).count true = 24 := by
  decide +kernel

theorem cone2_count : (List.ofFn flag2).count true = 264 := by
  decide +kernel

theorem cone3_count : (List.ofFn flag3).count true = 734 := by
  decide +kernel
end Minimum
end CyclicDecoderEntryCone
