def directly (e : E) : Bool :=
  (variableOthers oldDecoder e).any (fun f => decide (sourceEdge f))
def frontier (flag : E → Bool) (e : E) : Bool :=
  directly e || (variableOthers oldDecoder e).any
    (fun g => (incomingEdges oldDecoder g).any flag)

theorem directly_true (e : E) : directly e = true ↔ directlyAffected e := by
  simp [directly, directlyAffected, List.any_eq_true]

theorem frontier_true (flag : E → Bool) (e : E) :
    frontier flag e = true ↔ directlyAffected e ∨
      ∃ f, CyclicDecoderEntry.updateDepends oldDecoder e f ∧ flag f = true := by
  simp only [frontier, Bool.or_eq_true, directly_true, List.any_eq_true]
  apply or_congr Iff.rfl
  constructor
