def flag3 (e : E) : Bool := data3.get e.val

theorem first_certificate : ∀ e : E, directly e = flag1 e := by
  apply checked_all
  decide +kernel
theorem second_certificate : ∀ e : E, frontier flag1 e = flag2 e := by
  apply checked_all
  decide +kernel
theorem third_certificate : ∀ e : E, frontier flag2 e = flag3 e := by
  apply checked_all
  decide +kernel
theorem fourth_certificate : ∀ e : E, frontier flag3 e = true := by
  apply checked_all
  decide +kernel

theorem next_cone_iff (k : Nat) (flag : E → Bool)
    (previous : ∀ e, CyclicDecoderEntry.cone
      (CyclicDecoderEntry.updateDepends oldDecoder) directlyAffected k e ↔ flag e = true)
    (e : E) : CyclicDecoderEntry.cone
      (CyclicDecoderEntry.updateDepends oldDecoder) directlyAffected (k+1) e ↔
      frontier flag e = true := by
  rw [frontier_true]
  change (directlyAffected e ∨ ∃ f, CyclicDecoderEntry.updateDepends oldDecoder e f ∧
    CyclicDecoderEntry.cone (CyclicDecoderEntry.updateDepends oldDecoder) directlyAffected k f) ↔ _
  apply or_congr Iff.rfl
  constructor
  · rintro ⟨f,hf,h⟩
    exact ⟨f,hf,(previous f).mp h⟩
  · rintro ⟨f,hf,h⟩
    exact ⟨f,hf,(previous f).mpr h⟩

theorem cone1_iff (e : E) : CyclicDecoderEntry.cone
    (CyclicDecoderEntry.updateDepends oldDecoder) directlyAffected 1 e ↔ flag1 e = true := by
  change (directlyAffected e ∨ ∃ f, CyclicDecoderEntry.updateDepends oldDecoder e f ∧ False) ↔ _
  simp only [and_false, exists_false, or_false]
  rw [← first_certificate, directly_true]

theorem cone2_iff (e : E) : CyclicDecoderEntry.cone
    (CyclicDecoderEntry.updateDepends oldDecoder) directlyAffected 2 e ↔ flag2 e = true := by
  have h := next_cone_iff 1 flag1 cone1_iff e
  rw [second_certificate] at h
  exact h

theorem cone3_iff (e : E) : CyclicDecoderEntry.cone
    (CyclicDecoderEntry.updateDepends oldDecoder) directlyAffected 3 e ↔ flag3 e = true := by
  have h := next_cone_iff 2 flag2 cone2_iff e
  rw [third_certificate] at h
  exact h

/-- Every coordinate is in the possible-influence cone after four updates.
This does not assert that every coordinate actually differs. -/
theorem full_cone_at_four (e : E) : CyclicDecoderEntry.cone
    (CyclicDecoderEntry.updateDepends oldDecoder) directlyAffected 4 e := by
  have h := next_cone_iff 3 flag3 cone3_iff e
  rw [fourth_certificate] at h
  exact h.mpr rfl

theorem cone1_count : (List.ofFn flag1).count true = 24 := by
  decide +kernel

theorem cone2_count : (List.ofFn flag2).count true = 264 := by
  decide +kernel

theorem cone3_count : (List.ofFn flag3).count true = 729 := by
  decide +kernel
end Previous
namespace Minimum
open CyclicDecoderEntryBridge.Minimum
def directly (e : E) : Bool :=
  (variableOthers oldDecoder e).any (fun f => decide (sourceEdge f))
def frontier (flag : E → Bool) (e : E) : Bool :=
  directly e || (variableOthers oldDecoder e).any
    (fun g => (incomingEdges oldDecoder g).any flag)

theorem directly_true (e : E) : directly e = true ↔ directlyAffected e := by
  simp [directly, directlyAffected, List.any_eq_true]

theorem frontier_true (flag : E → Bool) (e : E) :
    frontier flag e = true ↔ directlyAffected e ∨
      ∃ f, CyclicDecoderEntry.updateDepends oldDecoder e f ∧ flag f = true := by
  simp only [frontier, Bool.or_eq_true, directly_true, List.any_eq_true]
  apply or_congr Iff.rfl
  constructor
  · rintro ⟨g,hg,f,hf,h⟩
    exact ⟨f,⟨g,hg,hf⟩,h⟩
  · rintro ⟨f,⟨g,hg,hf⟩,h⟩
    exact ⟨g,hg,f,hf,h⟩

