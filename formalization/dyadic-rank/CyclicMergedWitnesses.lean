deriving Inhabited

def splitPost (w : LocalInput) : Int := prior + w.otherMessages.sum + check w.sa w.xs
def mergedPost (w : LocalInput) : Int := prior + w.otherMessages.sum + check (w.sa ^^ w.sb) (w.xs ++ w.ys)

