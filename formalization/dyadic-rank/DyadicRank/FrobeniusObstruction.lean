module

public import Mathlib.Algebra.CharP.Two
public import Mathlib.RingTheory.Ideal.Operations

@[expose] public section

namespace DyadicRank

/-- Squaring an element in an ideal generated by g lands in the ideal generated by g². -/
theorem square_mem_span_squares {R : Type*} [CommRing R] [CharP R 2]
    {ι : Type*} (g : ι → R) {a : R} (ha : a ∈ Ideal.span (Set.range g)) :
    a ^ 2 ∈ Ideal.span (Set.range (fun i => g i ^ 2)) := by
  induction ha using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨i, rfl⟩ := hx
    exact Ideal.subset_span ⟨i, rfl⟩
  | zero => simp
  | add x y hx hy ihx ihy =>
    rw [CharTwo.add_sq]
    exact Ideal.add_mem _ ihx ihy
  | smul r x hx ih =>
    change (r * x) ^ 2 ∈ _
    rw [mul_pow]
    exact Ideal.mul_mem_left _ _ ih

/-- In characteristic two, a second-order element squares into a nonminimal relation ideal. -/
theorem square_mem_product_of_mem_square {R : Type*} [CommRing R] [CharP R 2]
    (m J : Ideal R) (hs : ∀ a ∈ m, a ^ 2 ∈ J) {f : R} (hf : f ∈ m ^ 2) :
    f ^ 2 ∈ m * J := by
  rw [pow_two] at hf
  refine Submodule.mul_induction_on (C := fun a : R => a ^ 2 ∈ m * J) hf ?_ ?_
  · intro a ha b hb
    rw [mul_pow]
    apply Ideal.mul_mem_mul _ (hs b hb)
    simpa only [pow_two] using m.mul_mem_left a ha
  · intro x y ihx ihy
    rw [CharTwo.add_sq]
    exact Ideal.add_mem _ ihx ihy

/-- The polynomial/regular-local obstruction needed by the proposed general proof. -/
theorem square_mem_generator_product {R : Type*} [CommRing R] [CharP R 2]
    {ι : Type*} (g : ι → R) {f : R} (hf : f ∈ (Ideal.span (Set.range g)) ^ 2) :
    f ^ 2 ∈ Ideal.span (Set.range g) * Ideal.span (Set.range (fun i => g i ^ 2)) :=
  square_mem_product_of_mem_square _ _ (fun _ h => square_mem_span_squares g h) hf

end DyadicRank
