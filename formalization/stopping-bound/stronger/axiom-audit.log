  have T := JointPowers.rightMarks γ n;
  have HX := JointSidon.X (ZMod 2) S T;
  have HZ := JointSidon.Z S T;
  HX * HZ.transpose = 0 ∧
    (∀ (v : Bool × ZMod n), {c | HX c v = 1}.card = γ) ∧
      (∀ (c : ZMod n), {v | HX c v = 1}.card = 2 * γ) ∧
        ∑ i, StoppingSpectral.eigs (JointSidon.X ℝ S T) i ^ 2 = 2 * ↑n * ↑γ * (3 * ↑γ - 1) ∧
          (∀ (U : Finset (Bool × ZMod n)), Incidence.Stopping (fun v c => HX c v = 1) U → γ + 1 ≤ U.card) ∧
            HX.mulVec SidonStopping.leftOnes = 0 ∧ ¬∃ a, HZ.transpose.mulVec a = SidonStopping.leftOnes
