  SidonStopping.X (ZMod 2) S * (SidonStopping.X (ZMod 2) S).transpose = 0 ∧
    (∀ (v : Bool × ZMod n), {c | SidonStopping.X (ZMod 2) S c v = 1}.card = γ) ∧
      (∀ (c : ZMod n), {v | SidonStopping.X (ZMod 2) S c v = 1}.card = 2 * γ) ∧
        (∀ (T : Finset (Bool × ZMod n)), Incidence.Stopping (SidonStopping.E S) T → 2 * (γ + 1) ≤ 3 * T.card) ∧
          (SidonStopping.X (ZMod 2) S).mulVec SidonStopping.leftOnes = 0 ∧
            (¬∃ a, (SidonStopping.X (ZMod 2) S).transpose.mulVec a = SidonStopping.leftOnes) ∧
              SidonStopping.X ℝ S * (SidonStopping.X ℝ S).transpose =
                SidonStopping.BadX ℝ S * (SidonStopping.BadX ℝ S).transpose
