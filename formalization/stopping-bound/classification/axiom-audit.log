Incidence.classifiesList_succ.{u_1, u_2} {V : Type u_1} {C : Type u_2} [DecidableEq V] [DecidableEq C]
  (pick : List V → Option C) (row : C → List V) (good : List V → Bool) (n : ℕ) (S : List V) :
  Incidence.classifiesList pick row good (n + 1) S =
    match pick S with
    | none => false
    | some c => (row c).all fun v => bif decide (v ∈ S) then true else Incidence.classifiesList pick row good n (v :: S)
