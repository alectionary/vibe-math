'Incidence.Family.plane_norm' depends on axioms: [propext, Classical.choice, Quot.sound]
Incidence.Family.plane_energy {n : ℕ} [NeZero n] (u : Fin 2 → ℝ) :
  StoppingSpectral.energy Incidence.Family.HR (Incidence.Family.plane u).ofLp =
    12 * StoppingSpectral.normSq (Incidence.Family.plane u).ofLp
'Incidence.Family.plane_energy' depends on axioms: [propext, Classical.choice, Quot.sound]
Incidence.Family.row_count_ge_two {n : ℕ} [NeZero n] : 2 ≤ Fintype.card (Incidence.Family.Check n)
'Incidence.Family.row_count_ge_two' depends on axioms: [propext, Classical.choice, Quot.sound]
Incidence.Family.second_lower_twelve {n : ℕ} [NeZero n] : 12 ≤ StoppingSpectral.eigs Incidence.Family.HR ⟨1, ⋯⟩
'Incidence.Family.second_lower_twelve' depends on axioms: [propext, Classical.choice, Quot.sound]
Incidence.Family.source_gap_impossible {n : ℕ} [NeZero n] : ¬StoppingSpectral.eigs Incidence.Family.HR ⟨1, ⋯⟩ < 3 / 2
'Incidence.Family.source_gap_impossible' depends on axioms: [propext, Classical.choice, Quot.sound]
Incidence.Family.zhu_chugg_bounds_negative {n : ℕ} [NeZero n]
  (hgap : StoppingSpectral.eigs Incidence.Family.HR ⟨1, ⋯⟩ < 18) :
  have s := StoppingSpectral.eigs Incidence.Family.HR ⟨1, ⋯⟩;
  14 * ↑n * (6 - s) / (18 - s) < 0 ∧ 2 * (14 * ↑n) * (10 - s) / (6 * (18 - s)) < 0
'Incidence.Family.zhu_chugg_bounds_negative' depends on axioms: [propext, Classical.choice, Quot.sound]
Incidence.normalized_roots_reject (b : Bool) :
  Incidence.survivesList Incidence.pickList Incidence.row 4 [(b, 0, 0)] = false
'Incidence.normalized_roots_reject' depends on axioms: [propext, Quot.sound]
