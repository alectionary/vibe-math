StoppingSpectral.DenseSource.source_certificate :
  StoppingSpectral.DenseSource.B = StoppingSpectral.supportCirculant {0, 1} ∧
    StoppingSpectral.DenseSource.expanded = StoppingSpectral.denseExample ∧
      StoppingSpectral.DenseSource.binary = StoppingSpectral.denseExampleBinary ∧
        StoppingSpectral.DenseSource.binaryZ = StoppingSpectral.denseExampleBinary ∧
          (∀ (j : Fin 4), ∑ i, StoppingSpectral.DenseSource.expanded i j = 2) ∧
            (∀ (i : Fin 2), ∑ j, StoppingSpectral.DenseSource.expanded i j = 4) ∧
              StoppingSpectral.eigs StoppingSpectral.DenseSource.expanded
                    ⟨1, StoppingSpectral.DenseSource.source_certificate._proof_1⟩ =
                  0 ∧
                StoppingSpectral.eigs StoppingSpectral.DenseSource.expanded
                      ⟨1, StoppingSpectral.DenseSource.source_certificate._proof_1⟩ <
                    2 / 2 ∧
                  StoppingSpectral.sourceSmallRoot 2 2
                        (StoppingSpectral.eigs StoppingSpectral.DenseSource.expanded
                          ⟨1, StoppingSpectral.DenseSource.source_certificate._proof_1⟩) =
                      0 ∧
                    StoppingSpectral.sourceLargeRoot 2 2
                          (StoppingSpectral.eigs StoppingSpectral.DenseSource.expanded
                            ⟨1, StoppingSpectral.DenseSource.source_certificate._proof_1⟩) =
                        2 ∧
                      StoppingSpectral.DenseSource.binary * StoppingSpectral.DenseSource.binaryZ.transpose = 0 ∧
                        ∀ (S : Finset (Fin 4)),
                          StoppingSpectral.IsStopping StoppingSpectral.DenseSource.expanded S ↔ 2 ≤ S.card
'StoppingSpectral.DenseSource.source_certificate' depends on axioms: [propext, Classical.choice, Quot.sound]
