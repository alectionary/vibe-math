ParametricRing.mixed_cycle.{u_1} {R : Type u_1} [CommRing R] [CharP R 2] (x : ℤ → R) (h0 : x 0 = 1)
  (hm : ∀ (c d : ℤ), x c * x d = x (c + d)) (a b : ℤ) :
  ParametricRing.U x a b * (ParametricRing.base x a b).transpose = ParametricRing.star x a b * ParametricRing.V x
GeneralLP.css_commutation {L : ℕ} [NeZero L] (e : Fin 3 → Fin 4 → ZMod L) (a : GeneralLP.XCheck L)
