CoverDistance.lower_bound.{u_1, u_2} {A : Type u_1} {B : Type u_2} [AddCommGroup A] [AddCommGroup B] [Fintype A]
  [Fintype B] [DecidableEq A] [DecidableEq B] (p : A →+ B) (e : Fin 3 → Fin 4 → A) (d s : ℕ)
  (hcode :
    ∀ (y : CyclicCover.Word B), CyclicCover.Kernel (fun i j => p (e i j)) y → y ≠ 0 → d ≤ (CoverWeight.support y).card)
  (hstop :
    ∀ (T : Finset (Fin 4 × B)), SmallStopping.Stopping (CyclicCover.Adjacent fun i j => p (e i j)) T → s ≤ T.card)
  (x : CyclicCover.Word A) (hx : CyclicCover.Kernel e x) (hn : x ≠ 0) : min d (2 * s) ≤ (CoverWeight.support x).card
