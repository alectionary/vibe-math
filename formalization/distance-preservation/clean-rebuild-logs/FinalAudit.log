Source11.diagnostic_refuted :
  VoltageCycles.NoFourVoltage Source11.voltage ∧
    VoltageCycles.NoSixVoltage Source11.voltage ∧
      ¬Source11.RowPairing ∧ ¬Source11.ColumnPairing ∧ Source11.classicalDistance = 12 ∧ Source11.quantumDistance ≤ 11
DistanceFamily.infinite_counterfamily {L : ℕ} [NeZero L] (hL : 11 ∣ L) :
  VoltageCycles.NoFourVoltage (FamilyNoShort.e L) ∧
    VoltageCycles.NoSixVoltage (FamilyNoShort.e L) ∧
      ¬FamilyNoShort.RowPairing L ∧
        ¬FamilyNoShort.ColumnPairing L ∧ DistanceFamily.quantumDistance L ≤ 11 ∧ 12 ≤ DistanceFamily.classicalDistance L
SourceDistance.source_counterfamily {L : ℕ} [NeZero L] (hL : 11 ∣ L) :
  (∀ (x : CyclicCover.Word (ZMod L)),
      (∀ (c : Fin 3 × ZMod L), ∑ v, SourceDistance.C c v * x v = 0) → x ≠ 0 → 12 ≤ (CoverWeight.support x).card) ∧
    ∃ u v, SourceDistance.LogicalX u v ∧ (CoverWeight.support (SourceModel.join u v)).card ≤ 11
SourceWordBridge.source_distance_drop {L : ℕ} [NeZero L] (hL : 11 ∣ L) :
  SourceWordBridge.quantumDistance L ≤ 11 ∧
    12 ≤ SourceWordBridge.classicalDistance L ∧
      SourceWordBridge.quantumDistance L < SourceWordBridge.classicalDistance L
SourceWordBridge.css_commutation {L : ℕ} [NeZero L] (a : SourceModel.XCheck L) (b : SourceModel.ZCheck L) :
  ∑ q, SourceModel.HZ b q * SourceModel.HX a q = 0
DistanceFamily.stronger_counterfamily {L : ℕ} [NeZero L] (hL : 11 ∣ L) :
  DistanceFamily.quantumDistance L < DistanceFamily.classicalDistance L ∧
    ∀ (x : Fin 3 → ZMod L → ZMod 2),
      FamilyTranspose.Kernel x →
        x ≠ 0 → DistanceFamily.classicalDistance L ≤ (CoverWeight.support (FamilyTranspose.word x)).card
FamilyTranspose.distance_characterization {L : ℕ} [NeZero L] :
  (∀ (x : Fin 3 → ZMod L → ZMod 2),
      FamilyTranspose.Kernel x → x ≠ 0 → (CoverWeight.support (FamilyTranspose.word x)).card = 2 * L) ∧
    ∃ x, FamilyTranspose.Kernel x ∧ x ≠ 0
FamilyConnected.connected {L : ℕ} [NeZero L] (a b : FamilyConnected.Vertex L) : FamilyConnected.Reach a b
FamilyGirth.exact_eight_certificate {L : ℕ} [NeZero L] (hL : 11 ∣ L) :
  VoltageCycles.NoFourVoltage (FamilyNoShort.e L) ∧
    VoltageCycles.NoSixVoltage (FamilyNoShort.e L) ∧ FamilyGirth.checks.Nodup ∧ FamilyGirth.variableVertices.Nodup
FamilyGirth.eight_edges {L : ℕ} [NeZero L] :
  VoltageCycles.Edge (FamilyNoShort.e L) (0, 0) (0, 0) ∧
    VoltageCycles.Edge (FamilyNoShort.e L) (1, 0) (0, 0) ∧
      VoltageCycles.Edge (FamilyNoShort.e L) (1, 0) (1, -1) ∧
        VoltageCycles.Edge (FamilyNoShort.e L) (2, 1) (1, -1) ∧
          VoltageCycles.Edge (FamilyNoShort.e L) (2, 1) (0, 1) ∧
            VoltageCycles.Edge (FamilyNoShort.e L) (1, 1) (0, 1) ∧
              VoltageCycles.Edge (FamilyNoShort.e L) (1, 1) (1, 0) ∧
                VoltageCycles.Edge (FamilyNoShort.e L) (0, 0) (1, 0)
SourceModel.inSpanX_iff {L : ℕ} [NeZero L] (u : Fin 4 → Fin 4 → ZMod L → ZMod 2) (v : Fin 3 → Fin 3 → ZMod L → ZMod 2) :
  SourceModel.InSpanX u v ↔ ∃ w, u = FamilyWords.stabilizerLeft w ∧ v = FamilyWords.stabilizerRight w
SourceModel.inSpanZ_iff {L : ℕ} [NeZero L] (u : Fin 4 → Fin 4 → ZMod L → ZMod 2) (v : Fin 3 → Fin 3 → ZMod L → ZMod 2) :
  SourceModel.InSpanZ u v ↔
    ∃ w,
      SourceModel.transpose u = FamilyWords.stabilizerLeft w ∧ SourceModel.transpose v = FamilyWords.stabilizerRight w
SourceModel.join_surjective {L : ℕ} [NeZero L] (w : FamilyWords.Qubit L → ZMod 2) : ∃ u v, SourceModel.join u v = w
SourceModel.qubit_card {L : ℕ} [NeZero L] : Fintype.card (FamilyWords.Qubit L) = 25 * L
SourceWordBridge.quantum_weight_iff {L : ℕ} [NeZero L] (n : ℕ) :
  SourceWordBridge.QuantumHasWeight L n ↔ DistanceFamily.QuantumHasWeight L n
SourceWordBridge.quantum_distance_eq {L : ℕ} [NeZero L] :
  SourceWordBridge.quantumDistance L = DistanceFamily.quantumDistance L
SourceWordBridge.classical_distance_eq {L : ℕ} [NeZero L] :
  SourceWordBridge.classicalDistance L = DistanceFamily.classicalDistance L
CyclicCover.projected_support_stopping.{u_1, u_2} {A : Type u_1} {B : Type u_2} [AddCommGroup A] [AddCommGroup B]
  [Fintype A] [Fintype B] [DecidableEq A] [DecidableEq B] (p : A →+ B) (e : Fin 3 → Fin 4 → A) (x : CyclicCover.Word A)
  (hx : CyclicCover.Kernel e x) (hn : x ≠ 0) :
  SmallStopping.Stopping (CyclicCover.Adjacent fun i j => p (e i j))
    (Finset.image (CyclicCover.project p) (CoverWeight.support x))
CoverWeight.zero_push_weight_doubles.{u_1, u_2} {A : Type u_1} {B : Type u_2} [Fintype A] [Fintype B] [DecidableEq A]
  [DecidableEq B] (p : A → B) (x : A → ZMod 2) (hz : CoverWeight.push p x = 0) :
  2 * (Finset.image p (CoverWeight.support x)).card ≤ (CoverWeight.support x).card
FamilyBaseGraph.code_lower_twelve (x : FamilyBaseGraph.Var → ZMod 2)
  (hx : ∀ (c : FamilyBaseGraph.Check), FamilyBaseGraph.boundary x c = 0) (hn : x ≠ 0) :
  12 ≤ (CoverWeight.support x).card
