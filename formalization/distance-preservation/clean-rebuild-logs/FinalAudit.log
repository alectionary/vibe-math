ParametricWords.source_parametric_obstruction {L : ℕ} [NeZero L] (a b : ZMod L) :
  (∀ (c : GeneralLP.XCheck L) (d : GeneralLP.ZCheck L),
      ∑ q, GeneralLP.HZ (ParametricWords.e a b) d q * GeneralLP.HX (ParametricWords.e a b) c q = 0) ∧
    GeneralLP.LogicalX (ParametricWords.e a b) (ParametricWords.U a b) ParametricWords.V ∧
      (CoverWeight.support (GeneralLP.join (ParametricWords.U a b) ParametricWords.V)).card ≤ 11
ParametricProjection.projected_counterfamily {L : ℕ} [NeZero L] (p : ZMod L →+ ZMod 11) (a b : ZMod L) (ha : p a = 1)
  (hb : p b = 5) :
  VoltageCycles.NoFourVoltage (ParametricWords.e a b) ∧
    VoltageCycles.NoSixVoltage (ParametricWords.e a b) ∧
      ¬ParametricProjection.RowPairing (ParametricWords.e a b) ∧
        ¬ParametricProjection.ColumnPairing (ParametricWords.e a b) ∧
